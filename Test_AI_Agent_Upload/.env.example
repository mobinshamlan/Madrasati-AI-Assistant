
OPENAI_API_KEY=your_openai_api_key

# --- Demo control dispatch (backend/notify.py, backend/call_context.py) ---
# Supabase project URL and PUBLISHABLE key (never a secret/service-role key). Used only to read a call
# context by its one-time token through public.get_call_context.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Same value as TAMMENI_DISPATCH_SECRET in the website's .env.local.
TAMMENI_DISPATCH_SECRET=
# mock (default): nothing is sent. twilio: real SMS/calls to the test numbers below only.
TAMMENI_PROVIDER=mock
# Comma-separated E.164 numbers allowed to receive test messages/calls. Every number used below must be listed.
# Calls go to PARENT_PHONE and messages to PARENT_PHONE1 (falls back to PARENT_PHONE when unset).
PARENT_PHONE=
PARENT_PHONE1=
TAMMENI_ALLOWED_DESTINATIONS=
# Existing settings used by make_call.py / test_sms.py and by real dispatch:
# TWILIO_ACCOUNT_SID=  TWILIO_AUTH_TOKEN=  TWILIO_FROM=  PARENT_PHONE=  PUBLIC_URL=
# SMS sender; defaults to the alphanumeric "Tammeni" proven by test_sms.py.
TWILIO_SMS_FROM=Tammeni
TEXT_MODEL=gpt-4.1-mini
