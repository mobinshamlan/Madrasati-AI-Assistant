# Copy to .env.local and fill these from your Supabase project's Connect dialog.
# Use only the public publishable key. Never add a secret/service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only address of the Python backend used for preference previews.
TAMMENI_BACKEND_URL=http://127.0.0.1:8000

# Demo accounts (server-only; never NEXT_PUBLIC). The parent account is signed in by the server when
# a visitor presses «ابدأ مع طمّني»; its password never reaches the browser. See docs/demo-control.md.
TAMMENI_DEMO_PARENT_EMAIL=
TAMMENI_DEMO_PARENT_PASSWORD=
# The operator signs in on /demo-control with these. The code reads them only in the local mode below.
TAMMENI_DEMO_OPERATOR_EMAIL=
TAMMENI_DEMO_OPERATOR_PASSWORD=
# Local demo only: set to 1 to open /demo-control as the operator without the form. Works only under
# `npm run dev` and only for requests from this machine (not via ngrok, the LAN or a deploy). Off when unset.
TAMMENI_LOCAL_OPERATOR=

# Shared secret between the website server and the Python backend (same value in both). Long and random.
TAMMENI_DISPATCH_SECRET=
