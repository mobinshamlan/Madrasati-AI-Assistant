# Copy to .env.local and fill these from your Supabase project's Connect dialog.
# Use only the public publishable key. Never add a secret/service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only address of the Python backend used for preference previews.
TAMMENI_BACKEND_URL=http://127.0.0.1:8000

# Demo accounts (server-only; never NEXT_PUBLIC). The parent account is signed in by the server when
# a visitor presses «ابدأ مع طمّني»; its password never reaches the browser. See docs/demo-control.md.
TAMMENI_DEMO_PARENT_EMAIL=
TAMMENI_DEMO_PARENT_PASSWORD=
# The operator signs in on /demo-control with these. The code reads them only in the local mode below.
TAMMENI_DEMO_OPERATOR_EMAIL=
TAMMENI_DEMO_OPERATOR_PASSWORD=
# Local demo only: set to 1 to open /demo-control as the operator without the form. Works only under
# `npm run dev` and only for requests from this machine (not via ngrok, the LAN or a deploy). Off when unset.
TAMMENI_LOCAL_OPERATOR=
# Shared demo URL (localhost or a tunnel such as ngrok): set to 1 so /demo-control signs in the
# existing operator account from the server, without a password form. The parent button already does
# this for the parent account on any host. Automatic sessions send with the mock provider only.
# Real Twilio stays on a password sign-in, and only when this is unset (or after that sign-in clears
# the shared marker). Off unless the value is exactly 1.
TAMMENI_SHARED_DEMO=

# Shared secret between the website server and the Python backend (same value in both). Long and random.
TAMMENI_DISPATCH_SECRET=

# Local demo direct database connection. Secret server key, NEVER NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Explicitly enable configured provider for manual tests only; mock otherwise.
TAMMENI_DEMO_REAL_DISPATCH=0
# Automatic sending of saved schedules. Off unless exactly 1. On its own this only ever records mock attempts.
TAMMENI_AUTO_DISPATCH=0
# Real automatic sending also needs TAMMENI_DEMO_REAL_DISPATCH=1. Keep 0 until a real test is approved.
TAMMENI_AUTO_DISPATCH_REAL=0
# Older due updates wait for an operator instead of going out by themselves (1-1440, default 120).
TAMMENI_AUTO_DISPATCH_MAX_LATE_MINUTES=120
